# API (apps/api) - read by pydantic-settings / os.environ
API_KEY=dev-api-key            # required header X-API-Key; change outside local dev
HASH_PEPPER=dev-pepper         # pepper for pseudonymous user-id hashing
ALLOWED_ORIGINS=["*"]          # JSON list; set explicit origins to enable credentialed CORS
DATABASE_URL=sqlite:///./nutrition.db
# CELERY_BROKER_URL=redis://localhost:6379/0   # unset = tasks run inline
# RULES_DIR=/path/to/rules                     # default: <repo>/rules

# Web (apps/web)
# BACKEND_INTERNAL_URL=http://localhost:8000   # where Next.js rewrites send API calls
# NEXT_PUBLIC_API_URL=                         # leave empty to call the API same-origin
