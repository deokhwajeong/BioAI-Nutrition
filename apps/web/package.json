{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:demo": "NEXT_PUBLIC_DEMO=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:api": "cd ../api && uv run python scripts/export_openapi.py > ../web/lib/openapi.json && cd ../web && openapi-typescript lib/openapi.json -o lib/api-schema.d.ts --default-non-nullable false"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.11.30",
    "eslint": "^10",
    "eslint-config-next": "^16.4.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^7"
  },
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.7",
      "source-map-js": ">=1.2.2",
      "@babel/core": ">=7.29.6"
    }
  }
}
